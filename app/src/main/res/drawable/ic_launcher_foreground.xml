<?xml version="1.0" encoding="utf-8"?>
<!--
  "Open wheel": a steering wheel whose rim is open at the top (an open system the driver can
  reach into) with a neon arc, the same light as the motion glow. Everything sits inside the
  66 dp safe zone of the adaptive icon; docs/images/icon.svg is the same drawing for the docs.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rim, open at the top -->
    <path
        android:pathData="M66,33.215 A24,24 0 1,1 42,33.215"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Neon arc: the motion glow travelling along the rim -->
    <path
        android:pathData="M66,33.215 A24,24 0 0,1 76.553,62.208"
        android:strokeColor="#00E5FF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Spokes -->
    <path
        android:pathData="M31,54 L47,54 M61,54 L77,54 M54,61 L54,77"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Hub -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,54 A8,8 0 1,0 62,54 A8,8 0 1,0 46,54 Z" />
</vector>
